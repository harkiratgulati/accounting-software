generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tenant {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String?
  users      User[]
  items      Item[]
  vendors    Vendor[]
  orders     Order[]
  itemCosts  ItemCost[]
  orderLines OrderLine[]
  forecasts  Forecast[]
  digests    Digest[]
}

model User {
  id        String @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  phone     String?
  role      String  @default("owner")
}

model Item {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  sku        String
  category   String?
  unit       String   @default("pcs")
  price      Float    @default(0)
  active     Boolean  @default(true)
  costs      ItemCost[]
  orderLines OrderLine[]

  @@index([tenantId, sku])
  @@unique([sku, tenantId], name: "sku_tenantId")
}

model ItemCost {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unitCost      Float    @default(0)
  effectiveFrom DateTime @default(now())
}

model Vendor {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  leadTimeDays Int     @default(1)
  moq          Int     @default(1)
}

model Order {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderTime  DateTime
  channel    String   @default("pos")
  subtotal   Float    @default(0)
  tax        Float    @default(0)
  fees       Float    @default(0)
  discount   Float    @default(0)
  lines      OrderLine[]

  @@index([tenantId, orderTime])
}

model OrderLine {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty       Int
  price     Float
}

model Forecast {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku       String
  date      DateTime
  qty       Int

  @@index([tenantId, date])
}

model Digest {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  date      DateTime
  content   String

  @@unique([tenantId, date], name: "tenantId_date")
}
